{
  "name": "@offgrid/rag",
  "version": "0.0.0",
  "private": true,
  "description": "Shared RAG decisions (chunking, retrieval, citations, turn building) for phone and desktop.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./documents": {
      "types": "./src/documents/index.ts",
      "default": "./src/documents/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "typesVersions": {
    "*": {
      "documents": [
        "src/documents/index.ts"
      ]
    }
  }
}
